<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Prevents backup of sensitive user data, auth tokens, and Firestore cache.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Disable cloud backup entirely for security -->
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <!-- Disable device-to-device transfer for security -->
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
