rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────
    function strLen(s) { return s.size(); }
    function validEmoji(e) { return e is string && strLen(e) >= 1 && strLen(e) <= 4; }
    function validUsername(u) { return u is string && strLen(u) >= 3 && strLen(u) <= 20; }
    function validEmail(e) { return e is string && strLen(e) <= 254; }
    function validUrl(u) { return u is string && strLen(u) <= 500; }
    function validTime(t) { return t is string && strLen(t) <= 10; }
    function validMode(m) { return m is string && m in ["Solo", "Duo", "Group"]; }
    function validChallenge(c) {
      return c is string && c in [
        "Math", "Memory", "Stroop", "Word", "Word Scramble", "Shake",
        "SpeedTap", "Speed Tap", "OddOneOut", "Odd One Out", "SlidingTiles", "Sliding Tiles",
        "OrbFocus", "Orb Focus", "BedTap", "Rapid Tap", "Typing", "Riddle", "Photo",
        "Voice", "Story", "Sacrifice"
      ];
    }
    function validDays(d) { return d is list && d.size() <= 7; }

    // ── USERS ──────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can READ (for search, leaderboard, social feed)
      allow read: if request.auth != null;

      // Owner can create profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                      'username', 'streak', 'wins', 'losses'
                    ])
                    && validUsername(request.resource.data.username)
                    && request.resource.data.streak is int
                    && request.resource.data.wins is int
                    && request.resource.data.losses is int;

      allow update: if request.auth != null
                    && (request.auth.uid == userId
                        || request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['streak', 'wins', 'losses', 'soloAlarmStreak', 'soloAlarmWins', 'soloAlarmLosses', 'duoAlarmStreak', 'duoAlarmWins', 'duoAlarmLosses', 'groupAlarmStreak', 'groupAlarmWins', 'groupAlarmLosses']));

      allow delete: if request.auth != null
                    && request.auth.uid == userId;

      // ── USER ALARMS ─────────────────────────────────────────────────
      // READ: any authenticated user
      // WRITE: authenticated users (allows partner sync for Duo/Group alarms)
      match /alarms/{alarmId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null;
      }

      // ── USER PUNISHMENTS ────────────────────────────────────────────
      // READ: owner can see their own punishments
      // WRITE: owner can create/update (for proof submission)
      match /punishments/{punishmentId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.loserUid is string
                      && request.resource.data.challengerUid is string
                      && request.resource.data.mode in ["Solo", "Duo", "Group"]
                      && request.resource.data.status in ["Assigned", "ProofSubmitted", "Completed", "Escalated", "Expired"]
                      && request.resource.data.punishmentEmoji is string
                      && strLen(request.resource.data.punishmentEmoji) <= 4
                      && request.resource.data.punishmentDetail is string
                      && strLen(request.resource.data.punishmentDetail) <= 200;

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && (!request.resource.data.diff('status').affectedKeys()
                          .hasAny(['status'])
                       || request.resource.data.status in ["Assigned", "ProofSubmitted", "Completed", "Escalated", "Expired"])
                      && (!request.resource.data.diff('proofUrl').affectedKeys()
                          .hasAny(['proofUrl'])
                       || request.resource.data.proofUrl is string
                       && strLen(request.resource.data.proofUrl) <= 500);

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      // ── USER NOTIFICATIONS ───────────────────────────────────────────
      // READ: owner can see their notifications
      // WRITE: owner can create (for punishment assignments)
      match /notifications/{notificationId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.type is string
                      && strLen(request.resource.data.type) <= 50
                      && request.resource.data.message is string
                      && strLen(request.resource.data.message) <= 500;

        allow update: if request.auth != null
                      && request.auth.uid == userId;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      // ── DEVICE TOKENS (for push notifications) ──────────────────────
      // READ: owner can see their tokens
      // WRITE: owner can create/update/delete their own tokens
      match /tokens/{tokenId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.token is string
                      && request.resource.data.platform in ["android", "ios"]
                      && request.resource.data.active is bool;

        allow update: if request.auth != null
                      && request.auth.uid == userId;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      // ── USER HABITS ─────────────────────────────────────────────────
      // READ: any authenticated user
      // WRITE: authenticated users (allows partner habit sync)
      match /habits/{habitId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null;
      }
    }

    // ── DUO ALARMS ─────────────────────────────────────────────────────
    // READ: any user can see (for leaderboard, social feed)
    // WRITE: only participants can modify
    match /duo_alarms/{alarmId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantUids
                    && validTime(request.resource.data.time)
                    && request.resource.data.label is string
                    && strLen(request.resource.data.label) <= 50
                    && validMode(request.resource.data.mode)
                    && validChallenge(request.resource.data.challenge)
                    && validDays(request.resource.data.days);

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantUids
                    && (!request.resource.data.diff('time').affectedKeys()
                        .hasAny(['time'])
                     || validTime(request.resource.data.time))
                    && (!request.resource.data.diff('label').affectedKeys()
                        .hasAny(['label'])
                     || request.resource.data.label is string
                     && strLen(request.resource.data.label) <= 50)
                    && (!request.resource.data.diff('winnerUid').affectedKeys()
                        .hasAny(['winnerUid'])
                     || request.resource.data.winnerUid is string
                     && strLen(request.resource.data.winnerUid) <= 128);

      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participantUids;
    }

    // ── BONDS ──────────────────────────────────────────────────────────
    // READ: any user can see (for leaderboard, social feed)
    // WRITE: only members can modify
    match /bonds/{bondId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantUids
                    && request.resource.data.name is string
                    && strLen(request.resource.data.name) <= 50
                    && request.resource.data.type in ["Duo", "Group"]
                    && request.resource.data.members is list
                    && request.resource.data.members.size() <= 8;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantUids
                    && (!request.resource.data.diff('name').affectedKeys()
                        .hasAny(['name'])
                     || request.resource.data.name is string
                     && strLen(request.resource.data.name) <= 50);

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }

    // ── SOCIAL FEED ──────────────────────────────────────────────────
    // READ: any authenticated user can see the feed
    // WRITE: authenticated users can create posts (their own)
    match /feed/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.username is string
                    && strLen(request.resource.data.username) <= 20
                    && request.resource.data.content is string
                    && strLen(request.resource.data.content) <= 500
                    && request.resource.data.badgeText is string
                    && strLen(request.resource.data.badgeText) <= 20
                    && request.resource.data.badgeColorHex is string
                    && request.resource.data.streak is int;

      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── STORIES ──────────────────────────────────────────────────────
    // READ: any authenticated user can view active stories
    // WRITE: authenticated users can create/delete their own stories
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── SOUNDS ─────────────────────────────────────────────────────────
    match /sounds/{soundId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── PUSH QUEUE (for Cloud Function processing) ────────────────────
    // Only authenticated users can create push queue entries
    // Cloud Functions handles the actual sending
    match /push_queue/{pushId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.toUid;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.toUid
                    && request.resource.data.fcmToken is string
                    && request.resource.data.title is string
                    && strLen(request.resource.data.title) <= 100
                    && request.resource.data.body is string
                    && strLen(request.resource.data.body) <= 500
                    && request.resource.data.type is string
                    && strLen(request.resource.data.type) <= 50;

      allow update: if false; // Only Cloud Functions can update (mark as processed)
      allow delete: if false; // Only Cloud Functions can delete
    }
  }
}
